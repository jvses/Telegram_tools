# ===== Credenciais e sessao do Telegram (NUNCA subir) =====
# user.session e a conta logada: quem tiver o arquivo acessa a conta.
*.session
*.session-journal
# api_id / api_hash gerados na primeira execucao (e o temporario da gravacao)
config.json
config.json.tmp
.env
.env.*

# ===== Dados de uso (conteudo pessoal / com direitos autorais) =====
# Telegram_topic_manager: pastas de cursos a enviar e ja enviadas
# (o **/ e necessario: "input/*" sozinho so valeria na raiz do repositorio)
**/input/*
!**/input/.gitkeep
output/
# Videos originais guardados depois da conversao com ffmpeg
originais/
# Telegram_specific_topic_dl: midias baixadas
downloads/
ideias_alteracoes.txt
# Midias soltas em qualquer outro lugar do repositorio.
# Para imagens de documentacao, use a pasta docs/ (liberada abaixo).
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.m4v
*.mp3
*.m4a
*.ogg
*.oga
*.opus
*.wav
*.pdf
*.zip
